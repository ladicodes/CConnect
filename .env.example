# Connect-Ask configuration. Copy to .env.local for development.
# Never commit real values. None of these are exposed to the browser.
#
# Running locally with no accounts at all? Use `npm run dev:local` instead:
# it starts a private local database and a local sign-in service, and needs
# none of the values below.

# --- Database (server only, secret) ------------------------------------------
# Supabase > Project Settings > Database > Connection string > Transaction pooler,
# using the dedicated `connect_ask_app` role (see docs/SETUP.md), for example:
# postgresql://connect_ask_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Used only by `npm run db:migrate` and `npm run staff` on your own machine.
# The `postgres` connection string from the same Supabase project.
# Do NOT add this to Vercel.
DATABASE_ADMIN_URL=

# --- Supabase Auth (staff sign-in) ------------------------------------------
# Supabase > Project Settings > API.
SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key.
SUPABASE_PUBLISHABLE_KEY=

# --- Privacy-preserving abuse protection (server only, secret) ---------------
# At least 32 random characters. Generate one with: openssl rand -base64 48
# Changing it resets "I have this question too" memory for every browser.
ANON_ID_SECRET=

# --- Public address -----------------------------------------------------------
# The permanent HTTPS address members use. The QR code points here.
# Development: http://localhost:3000
SITE_URL=http://localhost:3000

# Timezone used to display service dates and times (IANA name).
APP_TIMEZONE=UTC

# --- Optional: Cloudflare Turnstile -----------------------------------------
# Off unless BOTH values are set. Only enable if abuse appears; see docs/ANTI-ABUSE.md.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
